{
	"nodes": [
		{
			"class_name": "SystemAudioInput",
			"menu_info": {
				"category": "Audio",
				"display_name": "System Audio Input"
			},
			"node": {
				"class_name": "SystemAudioInput",
				"contents_type": "Job",
				"description": "Captures system audio output using loopback recording",
				"always_execute": true,
				"pins": [
					{
						"name": "Active",
						"display_name": "Active",
						"description": "Enable or disable system audio capture",
						"type_name": "bool",
						"show_as": "PROPERTY",
						"can_show_as": "INPUT_PIN_OR_PROPERTY",
						"data": true
					},
					{
						"name": "SampleRate",
						"display_name": "Sample Rate",
						"description": "Target sample rate for captured audio",
						"type_name": "uint",
						"show_as": "PROPERTY",
						"can_show_as": "INPUT_PIN_OR_PROPERTY",
						"data": 48000
					},
					{
						"name": "ChannelCount",
						"display_name": "Channel Count",
						"description": "Number of audio channels",
						"type_name": "ubyte",
						"show_as": "PROPERTY",
						"can_show_as": "INPUT_PIN_OR_PROPERTY",
						"data": 2
					},
					{
						"name": "Gain",
						"display_name": "Gain",
						"description": "Audio gain/volume multiplier",
						"type_name": "float",
						"show_as": "PROPERTY",
						"can_show_as": "INPUT_PIN_OR_PROPERTY",
						"data": 1.0,
						"min": 0.0,
						"max": 10.0
					},
					{
						"name": "AudioPacket",
						"display_name": "Audio Packet",
						"description": "Output audio packet containing captured system audio",
						"type_name": "nos.audio.AudioPacket",
						"show_as": "OUTPUT_PIN",
						"can_show_as": "OUTPUT_PIN_ONLY"
					}
				]
			}
		}
	],
	"schema_version": "1.4-v1"
}
