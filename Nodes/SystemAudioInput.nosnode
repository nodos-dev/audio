{
	"nodes": [
		{
			"class_name": "SystemAudioInput",
			"menu_info": {
				"category": "Audio",
				"display_name": "System Audio Input"
			},
			"node": {
				"class_name": "SystemAudioInput",
				"contents_type": "Job",
				"description": "Captures the system audio output (loopback) and passes it through at the\ndevice's native sample rate and channel count. Each frame emits exactly the\nsamples captured since the last tick, so the packet's sample count varies; the\nAudioPacket carries the detected format. Feed a Resample node downstream to\nconvert to a fixed rate.",
				"always_execute": true,
				"pins": [
					{
						"name": "Active",
						"display_name": "Active",
						"description": "Enable or disable system audio capture",
						"type_name": "bool",
						"show_as": "PROPERTY",
						"can_show_as": "INPUT_PIN_OR_PROPERTY",
						"data": true
					},
					{
						"name": "Gain",
						"display_name": "Gain",
						"description": "Linear gain applied to every captured sample before output",
						"type_name": "float",
						"show_as": "PROPERTY",
						"can_show_as": "INPUT_PIN_OR_PROPERTY",
						"data": 1.0,
						"min": 0.0,
						"max": 10.0
					},
					{
						"name": "AudioPacket",
						"display_name": "Audio Packet",
						"description": "Captured system audio at the device's native rate and channel count.\nSample count varies per frame; the descriptor reports the detected format.",
						"type_name": "nos.audio.AudioPacket",
						"show_as": "OUTPUT_PIN",
						"can_show_as": "OUTPUT_PIN_ONLY"
					}
				]
			}
		}
	],
	"schema_version": "1.4-v1"
}
